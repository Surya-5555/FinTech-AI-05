{
  "name": "razorpay-revenue-recovery",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start:ml": "cd apps/ml-pipeline && .\\venv\\Scripts\\Activate.ps1 && python src/server.py",
    "dev": "node api.js && pnpm --filter \"./apps/*\" dev",
    "build": "node api.js && pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "evaluate": "pnpm dlx tsx scripts/eval_runner.ts",
    "evaluate-smoke": "pnpm --filter @rr/evaluator start evaluate",
    "generate-dataset": "pnpm dlx tsx scripts/generate_evaluation_dataset.ts",
    "load-test": "pnpm dlx tsx scripts/load-test.ts",
    "failure-demo": "pnpm dlx tsx scripts/resilience-test.ts",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/common": "^12.1.3",
    "@nestjs/testing": "^12.1.3",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "bullmq": "^6.3.16",
    "ioredis": "^6.0.0",
    "razorpay": "^2.9.8",
    "resend": "^6.34.1",
    "twilio": "^6.2.0"
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.1.1",
      "lodash": ">=4.18.0",
      "js-yaml": ">=4.3.1"
    }
  }
}
