# Demo Environment Variables (Local Docker Compose)
# DO NOT add real secrets here. These are explicitly for local demo/simulation.

APP_ENV=demo
PORT=3000

# Infrastructure (resolved inside docker network)
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/razorpay_rr?schema=public"
REDIS_URL="redis://redis:6379"

# API & Security
API_AUTH_TOKEN="demo-secret-token"
CORS_ORIGINS="http://localhost:5173"
LOG_LEVEL="debug"
METRICS_ENABLED="true"

# Queue & Background Processing
QUEUE_ENABLED="true"
WORKER_CONCURRENCY="1"

# Demo Mode Overrides
DEMO_SEED="true"
DEMO_DATASET_VERSION="1"
ALLOW_DEMO_ENTITY_CREATION="true"

# Bounded AI Safety
LLM_ENABLED="false"

# External Providers (Strictly Demo)
RAZORPAY_MODE="test"
RAZORPAY_INTEGRATION_ENABLED="false"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
