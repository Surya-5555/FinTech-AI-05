# Test Environment Variables (CI or Local Testing)

APP_ENV=test
PORT=3000

# Infrastructure
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/razorpay_rr_test?schema=public"
REDIS_URL="redis://localhost:6379"

# API & Security
API_AUTH_TOKEN="test-secret-token"
CORS_ORIGINS="*"
LOG_LEVEL="silent"
METRICS_ENABLED="false"

# Queue & Background Processing
QUEUE_ENABLED="false"
WORKER_CONCURRENCY="1"

# Bounded AI Safety
LLM_ENABLED="false"

# External Providers (Strictly Demo)
RAZORPAY_MODE="test"
RAZORPAY_INTEGRATION_ENABLED="false"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET="test-secret"
